# Kintsugi-GRC Background RAG & Policy Vectorization Container
# Integrates FastAPI, ChromaDB Vector Engine, and Open Ollama endpoints (http://localhost:11434)
# Used for ingesting corporate policy documents and vectorizing against preseeded GRC controls

FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements for Vector DB & RAG Pipeline
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    requests \
    chromadb \
    sentence-transformers \
    pydantic

# Copy RAG pipeline scripts and preseeded control schemas
COPY ./src/placeholders/rag_pipeline.py /app/rag_pipeline.py
COPY ./grc_controls.zip /app/grc_controls.zip

EXPOSE 8000

ENV OLLAMA_ENDPOINT="http://host.docker.internal:11434"

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["python3", "-m", "uvicorn", "rag_pipeline:app", "--host", "0.0.0.0", "--port", "8000"]
