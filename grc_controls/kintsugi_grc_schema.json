{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kintsugi-grc-control-clauses-schema-v2",
  "title": "Kintsugi-GRC Control Clause and Vector Chunk Schema",
  "description": "v2 (2026-08-12, KINTGRC-13): anchors changed from 19 HITRUST Assessment Domains to 5 authoritative HITRUST CSF Control References (01.c, 06.d, 10.m, 09.q, 09.aa). Adds vectorization fields (chunk_id, embedding_text) so every mapping entry is an embedding-ready chunk for the FAISS index. Validates kintsugi_grc_control_clauses.json (default) and, via $defs, each per-framework file.",
  "type": "object",
  "required": [
    "hitrust_controls"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "jira": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "vectorization": {
      "$ref": "#/$defs/vectorization"
    },
    "hitrust_controls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/hitrust_control"
      }
    }
  },
  "$defs": {
    "vectorization": {
      "type": "object",
      "required": [
        "status",
        "embedding_field",
        "id_field"
      ],
      "properties": {
        "status": {
          "const": "embedding_ready"
        },
        "embedding_field": {
          "const": "embedding_text"
        },
        "id_field": {
          "const": "chunk_id"
        },
        "recommended_model": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "generated": {
          "type": "string"
        }
      }
    },
    "hitrust_anchor_fields": {
      "type": "object",
      "properties": {
        "control_reference": {
          "enum": [
            "01.c",
            "06.d",
            "10.m",
            "09.q",
            "09.aa"
          ]
        },
        "control_title": {
          "type": "string",
          "minLength": 1
        },
        "objective_id": {
          "type": "string",
          "pattern": "^\\d{2}\\.\\d{2}$"
        },
        "objective_title": {
          "type": "string",
          "minLength": 1
        },
        "category_id": {
          "type": "string",
          "pattern": "^\\d{2}\\.0$"
        },
        "category_title": {
          "type": "string",
          "minLength": 1
        },
        "requirement_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hitrust_control": {
      "allOf": [
        {
          "$ref": "#/$defs/hitrust_anchor_fields"
        }
      ],
      "type": "object",
      "required": [
        "control_reference",
        "control_title",
        "objective_id",
        "objective_title",
        "category_id",
        "category_title",
        "requirement_summary",
        "framework_mappings"
      ],
      "properties": {
        "control_reference": true,
        "control_title": true,
        "objective_id": true,
        "objective_title": true,
        "category_id": true,
        "category_title": true,
        "requirement_summary": true,
        "technical_validation_method": {
          "type": "string"
        },
        "framework_mappings": {
          "type": "object",
          "required": [
            "hipaa",
            "pci_dss_v4_0_1",
            "nist_800_53_r5",
            "nist_csf_2_0"
          ],
          "properties": {
            "hipaa": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mapping_entry"
              }
            },
            "pci_dss_v4_0_1": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mapping_entry"
              }
            },
            "nist_800_53_r5": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mapping_entry"
              }
            },
            "nist_csf_2_0": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mapping_entry"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "mapping_entry": {
      "type": "object",
      "required": [
        "chunk_id",
        "hitrust_control",
        "id",
        "title",
        "text",
        "mapping_rationale",
        "technical_validation_method",
        "citation",
        "embedding_text"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "description": "Globally unique vector-store ID: <framework>__<requirement-id>__<hitrust-ref>."
        },
        "hitrust_control": {
          "type": "object",
          "required": [
            "control_reference",
            "control_title"
          ],
          "properties": {
            "control_reference": {
              "enum": [
                "01.c",
                "06.d",
                "10.m",
                "09.q",
                "09.aa"
              ]
            },
            "control_title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Framework-native requirement/control identifier, e.g. 'AC-6', '164.312(b)', 'Req 7.2.1', 'PR.AA-05'."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Requirement/control clause text (verbatim where licensing permits)."
        },
        "mapping_rationale": {
          "type": "string",
          "minLength": 1
        },
        "technical_validation_method": {
          "type": "string",
          "minLength": 1,
          "description": "How Kintsugi-GRC's scanner modules technically validate evidence for this requirement."
        },
        "applicability": {
          "type": "string"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "embedding_text": {
          "type": "string",
          "minLength": 1,
          "description": "The exact string to embed for semantic search (requirement text + HITRUST anchor context)."
        }
      },
      "additionalProperties": false
    },
    "framework_file": {
      "type": "object",
      "required": [
        "framework",
        "framework_version",
        "jira",
        "vectorization",
        "mappings"
      ],
      "properties": {
        "framework": {
          "type": "string"
        },
        "framework_version": {
          "type": "string"
        },
        "jira": {
          "type": "string"
        },
        "authoritative_source": {
          "type": "string"
        },
        "vectorization": {
          "$ref": "#/$defs/vectorization"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mapping_entry"
          }
        },
        "non_applicable_note": {
          "type": "string"
        },
        "unsupported_mappings_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hitrust_file": {
      "type": "object",
      "required": [
        "framework",
        "framework_version",
        "jira",
        "vectorization",
        "controls"
      ],
      "properties": {
        "framework": {
          "const": "HITRUST CSF"
        },
        "framework_version": {
          "type": "string"
        },
        "jira": {
          "type": "string"
        },
        "structure_note": {
          "type": "string"
        },
        "vectorization": {
          "$ref": "#/$defs/vectorization"
        },
        "controls": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/hitrust_anchor_fields"
              }
            ],
            "type": "object",
            "required": [
              "control_reference",
              "control_title",
              "objective_id",
              "objective_title",
              "category_id",
              "category_title",
              "requirement_summary",
              "chunk_id",
              "technical_validation_method",
              "sources",
              "embedding_text"
            ],
            "properties": {
              "control_reference": true,
              "control_title": true,
              "objective_id": true,
              "objective_title": true,
              "category_id": true,
              "category_title": true,
              "requirement_summary": true,
              "chunk_id": {
                "type": "string"
              },
              "technical_validation_method": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "publisher",
                    "title",
                    "citation"
                  ]
                }
              },
              "embedding_text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}